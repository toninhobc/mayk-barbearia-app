{
  "expo": {
    "name": "Dom Cabral",
    "slug": "dom-cabral-barbearia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dom-cabral-icon.png",
    "scheme": "domcabral",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15100C",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15100C",
        "foregroundImage": "./assets/images/dom-cabral-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/dom-cabral-icon.png",
      "name": "Dom Cabral Barbearia",
      "themeColor": "#15100C",
      "backgroundColor": "#15100C"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Dom Cabral Barbearia usa suas fotos para você escolher a foto do seu perfil.",
          "cameraPermission": "A Dom Cabral Barbearia usa a câmera para você tirar a foto do seu perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15100C",
          "image": "./assets/images/dom-cabral-emblem.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
